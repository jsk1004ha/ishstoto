# PostgreSQL is the default production target.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ishs_toto?schema=public"

# For quick SQLite local development, copy prisma/schema.sqlite.prisma to prisma/schema.prisma
# or run Prisma commands with --schema prisma/schema.sqlite.prisma and use:
# DATABASE_URL="file:./dev.db"

SESSION_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ALLOW_PREDICTION_REVISION="true"
MAX_PREDICTION_REVISIONS="1"
INITIAL_POINTS="1000"
